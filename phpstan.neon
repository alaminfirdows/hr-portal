includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-modules.php

parameters:
    paths:
        - app/
        - modules/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    excludePaths:
        - modules/*/Tests/*

